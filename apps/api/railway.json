{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "package.json",
      "bun.lock",
      ".dockerignore"
    ]
  },
  "deploy": {
    "preDeployCommand": ["bun run db:deploy"],
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
