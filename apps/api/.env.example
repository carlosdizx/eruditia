# development | production | test
NODE_ENV=development
PORT=3000
LOG_LEVELS=log,error,warn,debug,verbose,fatal

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_LOGGING=false
# true si el proveedor exige TLS (Neon, Supabase, etc.).
DB_SSL=false

OBSERVE_APP_KEY=changeme
OBSERVE_APP_SECRET=changeme
OBSERVE_SERVICE_ID=changeme

SUPER_ADMIN_EMAIL=superadmin@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=changeme@gmail.com
SMTP_PASSWORD=changeme

SESSION_TTL_HOURS=24
SESSION_IDLE_TIMEOUT_MINUTES=120

# Proxies de confianza para X-Forwarded-For (IP real del navegador). Por defecto
# la red privada, donde corre el servidor de Next. Si delante de la API hay un
# balanceador con IP pública, usa el número de saltos (p. ej. 1) o su subred.
TRUST_PROXY=loopback,linklocal,uniquelocal
