NODE_ENV=development
PORT=3000
LOG_LEVELS=log,error,warn,debug,verbose,fatal

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_LOGGING=false

OBSERVE_APP_KEY=changeme
OBSERVE_APP_SECRET=changeme
OBSERVE_SERVICE_ID=changeme

# 32+ char random string, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=changeme
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of origins allowed to call this auth service
TRUSTED_ORIGINS=