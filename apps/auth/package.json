{
  "name": "auth",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "db:migrate": "ts-node -r tsconfig-paths/register src/database/scripts/migrator.ts up",
    "db:migrate:undo": "ts-node -r tsconfig-paths/register src/database/scripts/migrator.ts down",
    "db:migrate:undo:all": "ts-node -r tsconfig-paths/register src/database/scripts/migrator.ts down:all",
    "db:migrate:status": "ts-node -r tsconfig-paths/register src/database/scripts/migrator.ts status",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/scripts/seeder.ts up",
    "db:seed:undo": "ts-node -r tsconfig-paths/register src/database/scripts/seeder.ts down",
    "db:seed:undo:all": "ts-node -r tsconfig-paths/register src/database/scripts/seeder.ts down:all",
    "db:seed:status": "ts-node -r tsconfig-paths/register src/database/scripts/seeder.ts status",
    "db:migration:generate": "ts-node -r tsconfig-paths/register src/database/scripts/migration.generator.ts",
    "db:seed:generate": "ts-node -r tsconfig-paths/register src/database/scripts/seed.generator.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/sequelize": "^12.0.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@types/validator": "^13.15.10",
    "better-auth": "^1.7.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.8",
    "source-map-support": "^0.5.21",
    "sqlite3": "^6.0.1",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "webpack-node-externals": "^3.0.0"
  }
}
