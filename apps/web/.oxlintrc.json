{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["src/components/ui/**", "src/hooks/use-mobile.ts"],
  "plugins": ["typescript", "react", "jsx-a11y", "nextjs", "import"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "env": {
    "browser": true
  }
}
